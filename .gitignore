# ==========================
# PYTHON & GENERAL
# ==========================
# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/

# Environment Variables (Sensitive data)
.env
.env.local
.env.*.local

# IDE Settings
.vscode/
.idea/

# Logs and Databases
*.log
*.sqlite3

# ==========================
# AI / ML MODELS
# ==========================
# Large model weights (Usually stored in cache, but just in case)
models/
*.pt
*.bin
*.safetensors
*.h5
*.ckpt

# ==========================
# NODE.JS & REACT
# ==========================
# Dependencies
node_modules/
.npm/

# Production Build Output
build/
dist/

# Next.js specific (if you decide to use Next.js later)
.next/
out/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated Files
.DS_Store
Thumbs.db