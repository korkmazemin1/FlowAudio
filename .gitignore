# ==========================
# PYTHON & GENERAL
# ==========================
# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (Standard & uv)
venv/
env/
.venv/
.env/

# Environment Variables (Sensitive data)
.env
.env.local
.env.*.local

# IDE Settings
.vscode/
.idea/

# Logs and Databases
*.log
*.sqlite3
celerybeat-schedule

# ==========================
# AI / ML MODELS & DATA
# ==========================
# Large model weights (Usually stored in cache or external storage)
models/
*.pt
*.pth
*.bin
*.safetensors
*.h5
*.ckpt
*.onnx

# Datasets (Prevent uploading large datasets)
data/
datasets/

# ==========================
# NODE.JS & REACT
# ==========================
# Dependencies
node_modules/
.npm/

# Production Build Output
build/
dist/

# Next.js specific (in case you use Next.js)
.next/
out/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# OS GENERATED FILES
# ==========================
.DS_Store
Thumbs.db